public class NFEnqBackTrack extends Enquiry {

    @Override
    public List<String> setIds(List<FilterCriteria> filterCriteria, EnquiryContext enquiryContext) {

        DataAccess da = new DataAccess(this);

        String versionId = "";

        List<String> returnList = new ArrayList<>();
        List<String> verDropDownIdList = new ArrayList<>();
        List<String> rtnList = new ArrayList<>();

        // Get VERSION.NAME
        for (FilterCriteria fc : filterCriteria) {
            if ("VERSION.NAME".equals(fc.getFieldname())) {
                versionId = fc.getValue();
                break;
            }
        }

        try {

            VersionRecord verRec = new VersionRecord(da.getRecord("VERSION", versionId));

            // Dropdown Enquiries
            addDropDownValues(verRec.getFieldNo(), verDropDownIdList);

            // Validation Routine
            addValidationRoutines(verRec.getValidationFld(), rtnList);

            // Other routines
            addTFieldValues(verRec.getInputRoutine(), rtnList);
            addTFieldValues(verRec.getAuthRoutine(), rtnList);
            addTFieldValues(verRec.getIdRtn(), rtnList);
            addTFieldValues(verRec.getCheckRecRtn(), rtnList);
            addTFieldValues(verRec.getAfterUnauRtn(), rtnList);
            addTFieldValues(verRec.getBeforeAuthRtn(), rtnList);

            // Uncomment if your VersionRecord contains this method
            // addTFieldValues(verRec.getDefaultRoutine(), rtnList);

        } catch (Exception e) {
            e.printStackTrace();
        }
        if(verDropDownIdList!=null || !verDropDownIdList.isEmpty()){
            for( String x : verDropDownIdList ){
                EnquiryRecord enqRec = new EnquiryRecord(da.getRecord("ENQUIRY",x));
                String fileName = enqRec.getFileName().getValue(); // name of ss
                if(fileName.startsWith("NOFILE")){
                   StandardSelectionRecord ssRec = new StandardSelectionRecord(da.getRecord("STANDARD.SELECTION", fileName));
                   String ebApiId = ssRec.getUsrFieldName(0).getUsrFieldNo().get(0).getValue();
                }
            }
        }
        


        return returnList;
    }

    /**
     * Add values from List<TField> to target list.
     */
    private void addTFieldValues(List<TField> source, List<String> target) {

        if (source == null || source.isEmpty()) {
            return;
        }

        for (TField field : source) {

            if (field == null) {
                continue;
            }

            String value = field.getValue();

            if (value != null && !value.trim().isEmpty()) {
                target.add(value);
            }
        }
    }

    /**
     * Add dropdown enquiry names.
     */
    private void addDropDownValues(List<FieldNoClass> source, List<String> target) {

        if (source == null || source.isEmpty()) {
            return;
        }

        for (FieldNoClass field : source) {

            if (field == null) {
                continue;
            }

            String value = field.getDropDown().getValue();

            if (value != null && !value.trim().isEmpty()) {
                target.add(value);
            }
        }
    }

    /**
     * Add validation routines.
     */
    private void addValidationRoutines(List<ValidationFldClass> source, List<String> target) {

        if (source == null || source.isEmpty()) {
            return;
        }

        for (ValidationFldClass field : source) {

            if (field == null) {
                continue;
            }

            String value = field.getValidationRtn().getValue();

            if (value != null && !value.trim().isEmpty()) {
                target.add(value);
            }
        }
    }

}
