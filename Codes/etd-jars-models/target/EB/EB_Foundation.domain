    /* This application is designed to interface the host machine to DOS files via various terminal emulation protocols.
Currently three are supported:
1.  REFLECTION        2.  TERMITE        3.  PC/TCP
The files and records on the host machine must be standard flat ASCII files, that is hashed files and or records cannot be transferred.
The only functions allowed in this application are:
L  -  List        V  -  Verity        P  -  Print        R  -  Reverse        S  -  See        C  -  Copy        I  -  Input */
    HOST_TO_DOS
        @i18n:Description (en="")
        @t24:i (t24Name=HOST.TO.DOS, level=C, type=W, additionalInfo=NOG, allowedFunctions="C I L P Q R S V", localRefAllowed=false)
    {
        AUDITOR_CODE : T24BusinessTypes:A
            @i18n:Label (en="Auditor Code")
            @i18n:Tooltip (en="Auditor Code")
            @t24:i (align=L, inputBehaviour=E, maxLength=16, sysNumber=18.0, core=true, t24Name=AUDITOR.CODE, mandatory=false)
        AUDIT_DATE_TIME : T24BusinessTypes:RELTIME
            @i18n:Label (en="Audit Date Time")
            @i18n:Tooltip (en="Date and time when record was audited")
            @t24:i (align=L, inputBehaviour=E, maxLength=15, sysNumber=19.0, core=true, t24Name=AUDIT.DATE.TIME, mask="RDD DD  DD ##:##", mandatory=false)
        AUTHORISER : T24BusinessTypes:A
            @i18n:Label (en=Authoriser)
            @i18n:Tooltip (en="Indicates the User who Authorises the record")
            @t24:i (align=L, inputBehaviour=N, maxLength=100, sysNumber=15.0, core=true, t24Name=AUTHORISER, mandatory=false)
        CO_CODE -> ST_CompanyCreation:COMPANY
            @i18n:Label (en=Company)
            @t24:i (align=L, inputBehaviour=N, maxLength=11, sysNumber=16.0, core=true, businessType=A, t24Name=CO.CODE, mask="R##-###-####", mandatory=false)
        CURR_NO : T24BusinessTypes:N
            @i18n:Label (en="Curr No")
            @t24:i (align=R, inputBehaviour=N, maxLength=6, sysNumber=12.0, core=true, t24Name=CURR.NO, mandatory=false)
        DATE_TIME -> byValue EB_Foundation:HOST_TO_DOS__DATE_TIME *
            @t24:i (t24Name=DATE.TIME)
        DEPT_CODE -> ST_Config:DEPT_ACCT_OFFICER
            @i18n:Label (en="Dept Code")
            @t24:i (align=R, inputBehaviour=N, maxLength=6, sysNumber=17.0, core=true, t24Name=DEPT.CODE, mandatory=false)
            /* The DOS filename of the transferred record. This filename should contain any normal file extensions eg. TFR.XLS or TFR.TXT.
Validation Rules:
1 to 35 DOS characters.  (Mandatory input) */
        DOS_FILE : T24BusinessTypes:A required
            @t24:i (align=L, inputBehaviour=I, maxLength=12, sysNumber=5.0, core=true, t24Name=DOS.FILE, mandatory=true)
            /* The place on your PC where you want the record to be transferred to.
Typically this will be either a shared transfer area or a networked system, or a spreadsheet directory on the C: drive.
N.B.  If PC/TCP is used then the path must be the Unix path of the       logical DOS drive that you have mounted on your PC.
Validation Rules:
1 to 35 DOS characters.  (Mandatory input)
Great care should be taken when entering this DOS path as no validation is possible. */
        DOS_PATH : T24BusinessTypes:A required
            @t24:i (align=L, inputBehaviour=I, maxLength=35, sysNumber=4.0, core=true, t24Name=DOS.PATH, mandatory=true)
            /* This field is the type of terminal emulator that you are currently using.
Only the words REFLECTION, TERMITE and PC//TCP are allowed values to this field.
Validation Rules:
1 to 10 alphanumeric characters.  (Mandatory input) */
        EMULATOR : EB_Foundation:HOST_TO_DOS__EMULATOR required
            @t24:i (align=L, inputBehaviour=I, maxLength=10, sysNumber=1.0, core=true, t24Name=EMULATOR, mandatory=true)
        INPUTTER -> byValue EB_Foundation:HOST_TO_DOS__INPUTTER *
            @t24:i (t24Name=INPUTTER)
            /* The name of the record, any unique identifier.
Validation Rules:
1 to 30 alphanumeric characters. */
        NAME -> EB_Foundation:HOST_TO_DOS PK required
            @i18n:Label (en=Name)
            @i18n:Tooltip (en="Indicates the Name ")
            @t24:i (align=L, inputBehaviour=I, maxLength=30, sysNumber=0.0, core=true, businessType=A, t24Name=NAME, mandatory=true)
        RECORD_STATUS : T24BusinessTypes:STAT
            @i18n:Label (en="Record Status")
            @t24:i (align=L, inputBehaviour=N, maxLength=6, sysNumber=11.0, core=true, t24Name=RECORD.STATUS, mandatory=false)
            /* The name of the T24 file from which you wish to make a transfer.
This field contains the name of the T24 file from which you want to make the transfer.
Validation Rules:
1 to 35 alphanumeric characters.  (Mandatory input)
The file must exist and must be a T24 file. */
        SOURCE_FILE : T24BusinessTypes:A required
            @i18n:Label (en="Source File")
            @t24:i (align=L, inputBehaviour=I, maxLength=35, sysNumber=2.0, core=true, t24Name=SOURCE.FILE, mandatory=true)
            /* This is the record in the "SOURCE.FILE" that you want to transfer to DOS.
Validation Rules:
1 to 35 alphanumeric characters.  (Mandatory input)
The record must exist in the "SOURCE.FILE". */
        SOURCE_RECORD : T24BusinessTypes:ANY required
            @t24:i (align=L, inputBehaviour=I, maxLength=35, sysNumber=3.0, core=true, t24Name=SOURCE.RECORD, mandatory=true)
            /* This field is reserved for future expansion.
Validation Rules:
This is a NOINPUT field. */
        SPARE1 : T24BusinessTypes:N
            @t24:i (align=R, inputBehaviour=N, maxLength=1, sysNumber=10.0, core=true, t24Name=SPARE1, mandatory=false)
            /* This field is reserved for future expansion.
Validation Rules:
This is a NOINPUT field. */
        SPARE2 : T24BusinessTypes:N
            @t24:i (align=R, inputBehaviour=N, maxLength=1, sysNumber=9.0, core=true, t24Name=SPARE2, mandatory=false)
            /* This field is reserved for future expansion.
Validation Rules:
This is a NOINPUT field. */
        SPARE3 : T24BusinessTypes:N
            @t24:i (align=R, inputBehaviour=N, maxLength=1, sysNumber=8.0, core=true, t24Name=SPARE3, mandatory=false)
            /* This field is reserved for future expansion.
Validation Rules:
This is a NOINPUT field. */
        SPARE4 : T24BusinessTypes:N
            @t24:i (align=R, inputBehaviour=N, maxLength=1, sysNumber=7.0, core=true, t24Name=SPARE4, mandatory=false)
            /* This field is reserved for future expansion.
Validation Rules:
This is a NOINPUT field. */
        SPARE5 : T24BusinessTypes:N
            @t24:i (align=R, inputBehaviour=N, maxLength=1, sysNumber=6.0, core=true, t24Name=SPARE5, mandatory=false)
    }
    HOST_TO_DOS__DATE_TIME
    {
        DATE_TIME : T24BusinessTypes:RELTIME
            @i18n:Label (en="Date time")
            @i18n:Tooltip (en="Date and time when record was input or authorised")
