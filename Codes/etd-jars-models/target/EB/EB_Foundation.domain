        INPUTTER : T24BusinessTypes:A
            @i18n:Label (en=Inputter)
            @i18n:Tooltip (en="The user who last updated the record")
            @t24:i (align=L, inputBehaviour=N, maxLength=100, sysNumber=10.0, core=true, t24Name=INPUTTER, mandatory=false)
    }
    SYSTEM_RECORD__TRANSACTION
    {
    /* Transaction codes that are important(required) for the installation of the given application in the ID. Standard T24 alphanumeric field.
Validation Rules:

Must be a value from the TRANSACTION application.
A maximum of 3 characters may be entered. */
        TRANSACTION : T24BusinessTypes:A
            @i18n:Label (en=Transaction)
            @i18n:Tooltip (en="The reference number of the Transaction")
            @t24:i (align=L, inputBehaviour=I, maxLength=3, sysNumber=2.0, core=true, t24Name=TRANSACTION, mandatory=false)
    }
}
